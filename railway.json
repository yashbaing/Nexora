{
  "$schema": "https://schema.railway.app/railway-schema.json",
  "services": {
    "backend": {
      "source": {
        "type": "github"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "backend/Dockerfile",
        "watchPatterns": ["backend/**"]
      },
      "deploy": {
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  }
}
